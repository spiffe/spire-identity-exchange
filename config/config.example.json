{
  "name": "spire-identity-exchange",
  "logLevel": "info",
  "server": {
    "port": 8443,
    "metricsPort": 4950,
    "restPort": 8444,
    "tls": {
      "certFile": "./certs/svid.crt",
      "keyFile": "./certs/svid.key"
    }
  },
  "spire": {
    "unixSocketPath": "/tmp/spire-server/private/api.sock",
    "agentWorkloadSocketPath": "/tmp/spire-agent/public/api.sock",
    "agentDelegatedSocketPath": "/tmp/spire-agent/admin/api.sock",
    "trustDomain": "example.org",
    "svidTTL": "5m"
  },
  "githubOIDC": {
    "enabled": true,
    "issuer": "http://localhost:9999",
    "audiences": ["spire-identity-exchange"],
    "jwksUri": "http://localhost:9999/.well-known/jwks",
    "spiffeIdTemplate": "spiffe://{{.trust_domain}}/v2/github/{{.enterprise}}/{{.job_workflow_ref}}/{{.event_name}}",
    "allowedRepositories": ["*"],
    "requiredClaims": [
      "repository",
      "sha",
      "workflow_ref",
      "job_workflow_ref",
      "actor",
      "runner_environment",
      "run_id",
      "run_attempt",
      "event_name",
      "enterprise"
    ],
    "workflowTTLOverrides": {
      "my-org/my-repo/.github/workflows/deploy.yaml@refs/heads/main": "6h"
    },
    "skipTokenExpiration": false,
    "jwksCacheDuration": "5m",
    "svidTTL": "0s"
  },
  "k8sSAToken": {
    "enabled": false,
    "apiHost": "https://kubernetes.default.svc:443",
    "clusterName": "my-cluster",
    "audiences": ["spire-identity-exchange"],
    "spiffeIdTemplate": "spiffe://example.org/k8s/{{.sub}}",
    "tls": {
      "caFile": "",
      "certFile": "",
      "keyFile": ""
    }
  }
}
