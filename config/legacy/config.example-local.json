{
  "name": "spire-identity-exchange",
  "logLevel": "info",
  "purposeMode": "shared",
  "server": {
    "metricsPort": 9090,
    "tls": {
      "certFile": "./certs/server.crt",
      "keyFile": "./certs/server.key",
      "grpc": { "enable": true, "port": 8443 },
      "rest": { "enable": true, "port": 8444 }
    }
  },
  "spire": {
    "unixSocketPath": "/tmp/spire-server/private/api.sock",
    "agentWorkloadSocketPath": "/tmp/spire-agent/public/api.sock",
    "agentDelegatedSocketPath": "/tmp/spire-agent/admin/api.sock",
    "trustDomain": "example.org",
    "svidTTL": "1h"
  },
  "githubOIDC": {
    "enabled": true,
    "issuer": "http://localhost:9999",
    "audiences": ["spire-identity-exchange"],
    "jwksUri": "http://localhost:9999/.well-known/jwks",
    "spiffeIdTemplate": "spiffe://example.org/github/{{.repository_owner}}/{{.repository}}/{{.workflow}}",
    "allowedRepositories": ["*"],
    "requiredClaims": [
      "repository",
      "sha",
      "job_workflow_ref",
      "actor",
      "run_id",
      "event_name"
    ],
    "workflowTTLOverrides": {},
    "skipTokenExpiration": false,
    "jwksCacheDuration": "5m",
    "svidTTL": "0s"
  },
  "k8sSAToken": {
    "enabled": false,
    "clusterName": "my-cluster",
    "audiences": ["spire-identity-exchange"],
    "spiffeIdTemplate": "spiffe://example.org/k8s/{{.sub}}",
    "kubeconfig": ""
  }
}
