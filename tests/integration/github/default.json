{
  "name": "spire-identity-exchange",
  "logLevel": "info",
  "purposeMode": "shared",
  "server": {
    "port": 8443,
    "metricsPort": 4950,
    "restPort": 8444,
    "tls": {
      "certFile": "/etc/spire/identity-exchange/${SYSTEMD_INSTANCE}/certs/server.pem",
      "keyFile": "/etc/spire/identity-exchange/${SYSTEMD_INSTANCE}/certs/server.key"
    }
  },
  "spire": {
    "agentWorkloadSocketPath": "/var/run/spire/agent/sockets/${SYSTEMD_INSTANCE}/public/api.sock",
    "agentDelegatedSocketPath": "/var/run/spire/agent/sockets/${SYSTEMD_INSTANCE}-six/private/admin.sock",
    "trustDomain": "${SPIFFE_TRUST_DOMAIN}",
    "svidTTL": "5m"
  },
  "auth": {
    "plugins": [{
      "plugin": "github",
      "config": {
        "allowedRepositories": ["spiffe/spire-identity-exchange"],
        "audiences": ["spire-identity-exchange"]
      }
    },{
      "name": "mockhub",
      "plugin": "github",
      "config": {
        "issuerURL": "http://localhost:9999",
        "allowedRepositories": ["my-org/my-repo"],
        "audiences": ["spire-identity-exchange"]
      }
    }]
  }
}
