{
  "name": "spire-identity-exchange",
  "logLevel": "info",
  "server": {
    "port": 8443,
    "metricsPort": 4950,
    "restPort": 8444,
    "tls": {
      "certFile": "/etc/spire/identity-exchange/${SYSTEMD_INSTANCE}/certs/server.pem",
      "keyFile": "/etc/spire/identity-exchange/${SYSTEMD_INSTANCE}/certs/server.key"
    }
  },
  "spire": {
    "unixSocketPath": "/var/run/spire/server/sockets/${SYSTEMD_INSTANCE}/private/api.sock",
    "agentWorkloadSocketPath": "/var/run/spire/agent/sockets/${SYSTEMD_INSTANCE}/public/api.sock",
    "agentDelegatedSocketPath": "/var/run/spire/agent/sockets/six/private/admin.sock",
    "trustDomain": "${SPIFFE_TRUST_DOMAIN}",
    "svidTTL": "5m"
  },
  "auth": {
    "plugins": [{
      "plugin": "github",
      "config": {
        "allowedRepositories": ["spiffe/spire-identity-exchange"],
        "audiences": ["spire-identity-exchange"]
      }
    },{
      "name": "mockhub",
      "plugin": "github",
      "config": {
        "issuerURL": "http://localhost:9999",
        "allowedRepositories": ["my-org/my-repo"],
        "audiences": ["spire-identity-exchange"]
      }
    }]
  },
  "githubOIDC": {
    "enabled": true,
    "issuer": "http://localhost:9999",
    "audiences": ["spire-identity-exchange"],
    "jwksUri": "http://localhost:9999/.well-known/jwks",
    "spiffeIdTemplate": "spiffe://{{.trust_domain}}/spire-identity-exchange/github/{{.enterprise}}/{{.repository}}",
    "allowedRepositories": ["*"],
    "requiredClaims": [
      "repository",
      "sha",
      "workflow_ref",
      "job_workflow_ref",
      "actor",
      "runner_environment",
      "run_id",
      "run_attempt",
      "event_name",
      "enterprise"
    ],
    "workflowTTLOverrides": {},
    "skipTokenExpiration": false,
    "jwksCacheDuration": "5m",
    "svidTTL": "0s"
  },
  "k8sSAToken": {
    "enabled": false,
    "apiHost": "https://kubernetes.default.svc:443",
    "clusterName": "my-cluster",
    "audiences": ["spire-identity-exchange"],
    "spiffeIdTemplate": "spiffe://example.org/k8s/{{.sub}}",
    "tls": {
      "caFile": "",
      "certFile": "",
      "keyFile": ""
    }
  }
}
